// Types
interface Network {
  name: string;
  color: string;
  icon?: React.ReactNode;
  isTestnet?: boolean;
}

interface HistoryEntry {
  message: string;
  originalMessage: string;
  signature: string;
  timestamp: string;
  valid: boolean;
  messageType: MessageType;
  chainId: number;
  documentHash?: string;
  documentName?: string;
  signerEns?: string;
}

interface VerificationResult {
  valid: boolean;
  messageHash?: string;
  recoveredAddress?: string;
  messageType?: MessageType;
  timestamp: string;
  error?: string;
  documentHash?: string;
}

interface WalletInfo {
  name: string;
  icon: React.ReactNode;
  installUrl: string;
  supported: boolean;
  description: string;
}

interface DocumentInfo {
  name: string;
  size: number;
  type: string;
  lastModified: number;
  hash?: string;
  content?: ArrayBuffer;
}

